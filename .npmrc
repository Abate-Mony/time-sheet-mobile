# The Expo SDK 58 tree has one false peer conflict: @react-native-community/datetimepicker
# lists react-native-windows (pinned to an older React Native) as an optional peer, and
# this app never uses Windows. Every install — local and EAS's `npm ci` — must use the
# same peer-dependency mode as package-lock.json, or `npm ci` rejects the lockfile.
legacy-peer-deps=true
